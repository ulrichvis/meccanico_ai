# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES_PER_BATCH=20

# PostgreSQL / Prisma
# Use the Supabase transaction pooler for application queries.
DATABASE_URL=
# Use the Supabase direct connection or session pooler for Prisma migrations.
DIRECT_URL=

# Supabase (Phase 1, point 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=technical-sources

# OpenAI (server-only; used from Phase 2)
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
# Optional higher tiers, used only after a schema or text-quality failure.
OPENAI_EXTRACTION_MODEL_ESCALATION=
OPENAI_EXTRACTION_MODEL_EXCEPTIONAL=
OPENAI_EXTRACTION_MAX_ATTEMPTS=2

# OpenAI structured automotive analysis (server-only; independent from Phase 2)
OPENAI_AUTOMOTIVE_MODEL=
# Optional higher tiers, used only after a measurable schema or semantic failure.
OPENAI_AUTOMOTIVE_MODEL_ESCALATION=
OPENAI_AUTOMOTIVE_MODEL_EXCEPTIONAL=
OPENAI_AUTOMOTIVE_MAX_ATTEMPTS=2
OPENAI_AUTOMOTIVE_REASONING_EFFORT=medium
